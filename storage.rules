rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Blog imagery is public to read — it is rendered on public pages — and
    // writable only by an admin, capped at 8MB, images only. Without the
    // contentType check the bucket is an open file host.
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
